APP_ENV=demo
# Demo-enabled family accounts may select every elder without manual bindings.
# Ignored in production/prod; ordinary family accounts keep explicit grants.
DEMO_FAMILY_ALL_ELDERS=false
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=720
DATA_DIR=backend/data
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
AI_FALLBACK_MOCK=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SILICONFLOW_API_KEY=
SPEECH_TIMEOUT_SECONDS=45
VISION_API_KEY=
# Supports reusing the same actual key value as DEEPSEEK_API_KEY (not its variable name).
VISION_BASE_URL=https://api.deepseek.com/v1
VISION_MODEL=deepseek-flash
VISION_TIMEOUT_SECONDS=45

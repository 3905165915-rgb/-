[Unit]
Description=Hulaozhijiao demo backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hulaozhijiao
Group=hulaozhijiao
WorkingDirectory=/opt/hulaozhijiao/app
EnvironmentFile=/etc/hulaozhijiao/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hulaozhijiao-venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --limit-concurrency 24
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hulaozhijiao
UMask=0077

[Install]
WantedBy=multi-user.target

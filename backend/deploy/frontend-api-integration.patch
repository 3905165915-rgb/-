+    const groupResource: Record<string, string> = {
+      elders: 'elders',
+      admission: 'beds',
+      records: 'records',
+      tasks: 'tasks',
+      handovers: 'handovers',
+      quality: 'quality',
+      memories: 'memories',
+      changes: 'changes',
+      assessments: 'assessments',
+      plans: 'plans',
+      staff: 'staff',
+      incidents: 'incidents',
+    }

+const props = withDefaults(
+  defineProps<{
+    group: string
+    title?: string
+    context?: Row
+    initialAction?: string
+    autoRead?: boolean
+  }>(),
+  { title: '', context: () => ({}), initialAction: '', autoRead: false },
+)
+const emit = defineEmits<{ changed: []; select: [Row] }>()

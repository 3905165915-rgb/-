+const allowed = computed(() =>
+  operations.filter(
+    (op) => op.group === props.group && role && op.roles.includes(role),
+  ),
+)
+const activeId = ref('')
+const active = computed(
+  () =>
+    allowed.value.find((op) => op.id === activeId.value) || allowed.value[0],
+)
+const params = ref<Row>({})
+const body = ref<Row>({})
+const catalogs = ref<Record<string, Row[]>>({})
+const fieldOptions = computed(() => active.value
+  ? shiftFieldOptions(active.value, catalogs.value, readSession()) : {})
+const noWritableShift = computed(() => role === 'caregiver' && catalogs.value.shifts &&
+  writableShifts(catalogs.value.shifts, readSession()).length === 0)
+const selected = ref<Row>({ ...props.context })
+const result = ref<unknown>(null)
+const error = ref('')
+const message = ref('')
+const catalogErrors = ref<string[]>([])
+const busy = ref(false)
+const loading = ref(false)
+const confirm = ref(false)
+const pendingKeys = new Map<string, string>()
+function formKey() {
+  return `hulao:workflow:${readSession()?.accountKey}:${props.group}:${active.value?.id}:${JSON.stringify(props.context)}`
+}
+function restoreForm() {
+  if ('password' in body.value) return
+  try {
+    const saved = JSON.parse(sessionStorage.getItem(formKey()) || 'null')
+    if (saved?.params && saved?.body) {
+      params.value = saved.params
+      body.value = saved.body
+      if (saved.signature && saved.key)
+        pendingKeys.set(saved.signature, saved.key)
+    }
+  } catch {
+    /* An unreadable tab draft never prevents server access. */
+  }
+}
+function persistForm() {
+  if (!active.value || 'password' in body.value) return
+  try {
+    const latest = [...pendingKeys.entries()].at(-1)
+    sessionStorage.setItem(
+      formKey(),
+      JSON.stringify({
+        params: params.value,
+        body: body.value,
+        signature: latest?.[0],
+        key: latest?.[1],
+      }),
+    )
+  } catch {
+    error.value = '当前标签草稿保存失败，请保留输入内容后再离开页面。'
+  }
+}
+const bodySchema = computed(() => {
+  if (!active.value?.schema) return null
+  const refName = active.value.schema.$ref?.split('/').pop()
+  return refName ? schemas[refName] : active.value.schema
+})
+const paths: Record<string, string> = {
+  elders: '/elders',
+  beds: '/beds',
+  staff:
+    role === 'admin' || role === 'supervisor' ? '/staff/directory' : '/staff',
+  shifts: '/shifts',
+  records: '/records',
+  drafts: '/records/drafts',
+  tasks: '/tasks',
+  memories: '/memories',
+  handovers: '/handovers',
+  assessments: '/assessments',
+  plans: '/care-plans',
+  changes: '/change-reviews',
+  quality: '/quality/checks',
+  incidents: '/incidents',
+  family_accounts: '/family/accounts',
+  bindings:
+    role === 'family' ? '/family/me/bindings' : '/family/cases?kind=binding',
+  summaries: '/family/cases?kind=summary',
+  feedback: '/family/cases?kind=feedback',
+}
+const paginated = new Set([
+  'staff',
+  'records',
+  'drafts',
+  'shifts',
+  'memories',
+  'handovers',
+  'assessments',
+  'plans',
+  'changes',
+  'quality',
+  'incidents',
+  'bindings',
+  'summaries',
+  'feedback',
+  'family_accounts',

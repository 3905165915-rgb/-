{
  "name": "@hulao/frontend",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @hulao/admin-web dev",
    "dev:mobile": "pnpm --filter @hulao/mobile dev",
    "build": "pnpm --filter @hulao/admin-web build && pnpm --filter @hulao/mobile build",
    "build:deploy": "pnpm --filter @hulao/admin-web build --base / && pnpm --filter @hulao/mobile build --base /mobile/",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node e2e/all.mjs",
    "test:care-arrangement": "node e2e/care-arrangement.mjs",
    "dev:workflow": "vite --config vite.workflow.config.ts",
    "test:ui": "node e2e/ui.mjs",
    "dev:demo": "vite --config vite.demo.config.ts --mode demo --host 127.0.0.1 --port 5175 --strictPort",
    "build:demo": "vite build --config vite.demo.config.ts --mode demo",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "pnpm --filter @hulao/admin-web typecheck && pnpm --filter @hulao/mobile typecheck",
    "cap:sync": "pnpm --filter @hulao/mobile exec cap sync android",
    "cap:android": "pnpm --filter @hulao/mobile exec cap open android"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^14.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0"
  }
}
